# Uniquement des variables publiques (NEXT_PUBLIC_*) : aucun secret côté frontend.

# API backend, préfixe /v1 compris.
NEXT_PUBLIC_API_URL=http://localhost:3001/v1

# Dev local contre l’API en ligne (CORS limité à l’origine de production) :
# le serveur de dev relaie /v1/* vers cette adresse. Mettre alors
# NEXT_PUBLIC_API_URL=http://localhost:3000/v1. Sans effet en production.
# NEXT_PUBLIC_DEV_API_PROXY=https://giya-backend-gpy4.onrender.com

# WebSocket KDS (optionnel) : préfixe /v1 compris. Absent = dérivé de NEXT_PUBLIC_API_URL.
# NEXT_PUBLIC_WS_URL=ws://localhost:3001/v1

# URL publique du frontend (QR codes des tables, liens de vitrine).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Adresse des sites publics (lib/tenant-url.ts) :
# - domaine acheté (ex. giyax.com) : {slug}.giyax.com. Il faut un DNS générique
#   *.giyax.com vers Vercel et le domaine générique ajouté au projet Vercel ;
# - giyax.vercel.app ou localhost : {APP_URL}/{slug} (Vercel ne sert pas les
#   sous-domaines de vercel.app).
# Sans valeur : le domaine de NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_ROOT_DOMAIN=giyax.vercel.app

# Forcer (true) ou couper (false) les sous-domaines. Par défaut : actifs dès que
# NEXT_PUBLIC_APP_URL est servi sur NEXT_PUBLIC_ROOT_DOMAIN (hors vercel.app).
# NEXT_PUBLIC_TENANT_SUBDOMAINS=true

# Hébergeurs d'images autorisés par la CSP (affiches, photos), séparés par des espaces.
# NEXT_PUBLIC_IMAGE_ORIGINS=https://res.cloudinary.com

# Boutons de connexion démo sans backend (prévisualisation des écrans). Jamais en production.
# NEXT_PUBLIC_DEMO_MODE=true

# Fonctions dont le support serveur arrive par étapes (voir src/lib/features.ts).
# ticket-extras : early bird (saleEndsAt) et modèle de billet enregistrés par le serveur.
# table-occupancy : nombre de personnes (guestCount) envoyé avec les commandes sur place.
# NEXT_PUBLIC_FEATURES=ticket-extras table-occupancy
